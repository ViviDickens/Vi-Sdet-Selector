# Backend API - FastAPI
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy server code (server/rules.py + server/reasoning.py — no external
# model file or dataset needed, the rule engine is pure Python logic)
COPY server/ ./server

# Expose FastAPI on port 8000
EXPOSE 8000

CMD ["uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8000"]
