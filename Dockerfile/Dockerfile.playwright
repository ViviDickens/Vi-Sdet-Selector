# Playwright SDK - TypeScript
FROM mcr.microsoft.com/playwright:v1.47.2-focal

WORKDIR /sdk

# Copy Playwright SDK code
COPY playwright-sdk/ ./playwright-sdk

# Install dependencies (browsers already baked into this base image).
# npm ci, not npm install — installs exactly what package-lock.json pins.
WORKDIR /sdk/playwright-sdk
RUN npm ci

# Runs the example suite (tests/saucedemo.spec.ts) against the API
# container. Needs VI_SDET_SELECTOR_URL pointing at the api service
# (set in docker-compose.yml) since "localhost" inside this container
# is not the api container.
CMD ["npx", "playwright", "test"]
